#
# copy this file as .env
# Values are not quoted, so the file also works with "docker run --env-file",
# which would keep the quotes as part of the value.

# AppAPI environment variables
AA_VERSION=3.2.0
APP_SECRET=12345
APP_ID=live_transcription
APP_DISPLAY_NAME=Live Transcription
APP_VERSION=0.1.0
APP_PROTOCOL=http
APP_HOST=0.0.0.0
APP_PORT=23000
APP_PERSISTENT_STORAGE=persistent_storage
NEXTCLOUD_URL=http://nextcloud.local
COMPUTE_DEVICE=CPU

# matches the HPB setup in readme.md
LT_HPB_URL=wss://nextcloud.local/standalone-signaling/spreed
LT_INTERNAL_SECRET=7890
LT_ASR_SERVER_URL=ws://localhost:2702
LT_DISABLE_INTERNAL_ASR=false
SKIP_CERT_VERIFY=false
# Leave empty for the default: one decode worker per CPU core.
LT_MAX_WORKERS=
LT_ASR_THREADS=1
